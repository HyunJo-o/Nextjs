{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    //"baseUrl": ".",
    //baseUrl 없애도 된대여 쓸모가 없대여...이걸 없애면 어떻게 쓰냐? path를 봐라 @가 있잖냐
    "noUncheckedSideEffectImports": false,

    "paths": {
      "@/*": ["./*"]
      // ./를 기준으로 사용하겠다는 의민데 우리가 넘 옛날걸 다운받아서 그래
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/lib/placeholder-data.ts",
    "scripts/seed.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
